{
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".pytest_cache": true,
    ".gitignore": true,
    "pytest.ini": true,
    "__init__.py": true,

  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "cSpell.words": [
    "Toastify",
    "Uncategorized"
  ]
}