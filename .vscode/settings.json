{
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".pytest_cache": true,
    ".gitignore": true,
    "pytest.ini": true,
    "__init__.py": true,
    ".env": true,
    ".vscode": true,
    "frontend/build":true,
    "frontend/node_modules": true,
    "frontend/public":true,
    "frontend/src/App.css":true,
    "frontend/src/App.test.js":true,
    "frontend/src/logo.svg":true,
    "frontend/src/reportWebVitals.js":true,
    "frontend/src/service-worker.js":true,
    "frontend/src/index.css":true,
    "frontend/src/serviceWorkerRegistration.js":true,
    "frontend/src/setupTests.js":true,
    // "frontend/src/index.js":true,
    "frontend/.gitignore":true,
    "frontend/package-lock.json":true,
    // "frontend/package.json":true,
    "frontend/postcss.config.js":true,
    "frontend/pnpm-lock.yaml":true,
    "frontend/pnpm-worksapce.yaml":true,
    "frontend/webpack.config.js":true,
    "frontend/package-old.json":true,

  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "cSpell.words": [
    "Toastify",
    "Uncategorized"
  ]
}