{

  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".pytest_cache": true,
    ".gitignore": true,
    "pytest.ini": true,
    "__init__.py": true,

  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "cSpell.words": [
    "Toastify",
    "Uncategorized"
  ],

  // Auto-activate .venv for every new integrated terminal via a custom profile
  "terminal.integrated.profiles.linux": {
    "Python (workspace .venv)": {
      "path": "/bin/zsh",
      "args": ["-l"],
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "icon": "python"
    }
  },
  "terminal.integrated.defaultProfile.linux": "Python (workspace .venv)"
}