# Core security
ENCRYPTION_KEY=replace-with-generated-fernet-key

# Assistant fallback configuration
# Optional server-level fallback if a restaurant-specific OpenAI key is not saved in Settings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_UPLOADS_DIR=

# Future vector-store configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=prepiq-assistant